{
  "name": "vinttea",
  "version": "2.0.3",
  "private": true,
  "license": "MIT",
  "description": "Control remoto de streaming desde el celular para PC",
  "scripts": {
    "build": "pnpm -r run build",
    "build:launcher": "powershell -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "package:release": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "dev:server": "pnpm --filter @vinttea/server dev",
    "dev:remote": "pnpm --filter @vinttea/remote dev",
    "dev:extension": "pnpm --filter @vinttea/extension dev",
    "dev": "pnpm dev:server",
    "test": "node test-e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
